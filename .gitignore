# Ignore node modules everywhere
node_modules/

# Ignore build output
dist/

# Ignore environment files
.env
.env.local
.env.*.local
**/.env
!**/.env.example

# Ignore package lock artifacts
package-lock.json
yarn.lock
pnpm-lock.yaml

# Ignore editor and OS files
.DS_Store
.idea/
.vscode/

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore generated coverage files
coverage/

# Ignore project-specific local files
*.log
